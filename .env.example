# Free key from https://etherscan.io/apis — one key covers Base and Ethereum on the V2 API.
ETHERSCAN_API_KEY=

# Optional: Coinbase Developer Platform key, unlocks OnchainKit hosted components.
# https://portal.cdp.coinbase.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Public URL of the deployment. Required for Mini App embeds and the manifest.
NEXT_PUBLIC_URL=http://localhost:3000

# Optional: custom Base RPC. Defaults to https://mainnet.base.org
BASE_RPC_URL=

# Filled in by `npx create-onchain --manifest` after the first deploy.
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
